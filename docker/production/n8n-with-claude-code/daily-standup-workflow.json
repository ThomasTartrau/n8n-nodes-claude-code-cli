      "id": "86c9665a-086e-4ee2-8164-5a87a3f0524b",
      "name": "Merge All Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1232,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst seen = new Set();\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  let normalized;\n\n  if (j.sha) {\n    normalized = { source: 'github', id: j.sha, title: (j.commit?.message || '').split('\\n')[0], author: j.commit?.author?.name || '', timestamp: j.commit?.author?.date || '' };\n  } else if (j.subject !== undefined && j.tracker !== undefined) {\n    normalized = { source: 'redmine', id: `redmine-${j.id}`, title: `#${j.id} ${j.subject}`, status: j.status?.name || '', timestamp: j.updated_on || '' };\n  } else if (j.ts && j.text !== undefined) {\n    normalized = { source: 'slack', id: `slack-${j.ts}`, title: (j.text || '').slice(0, 200), author: j.user || '', timestamp: j.ts || '' };\n  } else {\n    normalized = { source: 'unknown', id: JSON.stringify(j).slice(0, 64), title: '', timestamp: '' };\n  }\n\n  const key = `${normalized.source}:${normalized.id}`;\n  if (seen.has(key)) continue;\n  seen.add(key);\n  out.push(normalized);\n}\n\nconst grouped = {\n  date: $today.toISODate(),\n  github: out.filter(x => x.source === 'github'),\n  redmine: out.filter(x => x.source === 'redmine'),\n  slack: out.filter(x => x.source === 'slack'),\n};\n\nreturn [{ json: grouped }];"
      },
