      "parameters": {
        "jsCode": "  function grab(name) {\n    try { return $(name).all().map(i => i.json); } catch (e) { return []; }\n  }\n\n  // --- GitHub ---\n  let gh = grab('GitHub Commits');\n  if (gh.length === 1 && Array.isArray(gh[0])) gh = gh[0];\n  const ghLines = gh.length\n    ? gh.map(c => `- ${(c.sha||'').slice(0,7)} ${(c.commit?.message||'').split('\\n')[0]}`).join('\\n')\n    : '- (no commits in last 24h)';\n\n  // --- Redmine ({ issues: [...] }) ---\n  let rm = grab('Redmine Issues');\n  let issues = (rm.length === 1 && Array.isArray(rm[0]?.issues)) ? rm[0].issues : rm;\n  const rmLines = issues.length\n    ? issues.map(i => `- #${i.id} [${i.status?.name||''}] ${i.subject||''}`).join('\\n')\n    : '- (no Redmine issues)';\n\n  const activity = `\n  GitHub commits (last 24h):\n  ${ghLines}\n\n  Redmine issues assigned to me:\n  ${rmLines}\n\n  Slack messages today:\n  - (Slack chưa kết nối)\n  `.trim();\n\n  return [{ json: { activity } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        0
      ],
      "id": "f00e78b6-d7b4-4949-bbe8-7059e234d9ca",
      "name": "Code in JavaScript"
    },
    {
